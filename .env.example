# Required for transcription and moment selection
OPENAI_API_KEY=sk-your-key-here

# Optional model overrides
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_MOMENT_MODEL=gpt-5-mini

# Local app URLs
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase accounts and history
# The NEXT_PUBLIC values also belong in web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Generate with:
# python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
