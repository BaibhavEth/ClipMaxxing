# Required for transcription and moment selection
OPENAI_API_KEY=sk-your-key-here

# Optional model overrides
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_MOMENT_MODEL=gpt-5-mini
OPENAI_SOCIAL_MODEL=gpt-5

# App URLs
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: residential HTTP/SOCKS proxy if YouTube blocks the cloud IP
# YTDLP_PROXY=socks5://user:pass@host:1080
# YOUTUBE_COOKIES_FILE=/app/data/youtube-cookies.txt
